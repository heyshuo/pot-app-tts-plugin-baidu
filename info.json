{
  "id": "plugin.com.pot-app.baidu_tts",
  "plugin_type": "tts",
  "icon": "baidu.svg",
  "display": "百度语音合成",
  "homepage": "https://github.com/heyshuo/pot-app-tts-plugin-baidu",
  "needs": [
    {
      "key": "apiKey",
      "display": "API Key",
      "type": "input"
    },
    {
      "key": "secretKey",
      "display": "Secret Key",
      "type": "input"
    },
    {
      "key": "per",
      "display": "发音人",
      "type": "select",
      "options": {
        "0": "度小美（基础）",
        "1": "度小宇（基础）",
        "3": "度逍遥（基础）",
        "4": "度丫丫（基础）",
        "5003": "度逍遥（精品）",
        "5118": "度小鹿（精品）",
        "106": "度博文（精品）",
        "110": "度小童（精品）",
        "111": "度小萌（精品）",
        "4003": "度逍遥（臻品）",
        "4106": "度博文（臻品）",
        "4115": "度小贤（臻品）",
        "4119": "度小鹿（臻品）",
        "4105": "度灵儿（臻品）",
        "4117": "度小乔（臻品）",
        "4100": "度小雯（臻品）"
      }
    },
    {
      "key": "spd",
      "display": "语速",
      "type": "select",
      "options": {
        "5.0": "5（正常）",
        "0.0": "0（最慢）",
        "3.0": "3（较慢）",
        "7.0": "7（稍快）",
        "9.0": "9（较快）",
        "11.0": "11（快）",
        "13.0": "13（很快）",
        "15.0": "15（最快）"
      }
    },
    {
      "key": "pit",
      "display": "音调",
      "type": "select",
      "options": {
        "5.0": "5（正常）",
        "0.0": "0（最低）",
        "3.0": "3（较低）",
        "7.0": "7（稍高）",
        "9.0": "9（较高）",
        "11.0": "11（高）",
        "13.0": "13（很高）",
        "15.0": "15（最高）"
      }
    },
    {
      "key": "vol",
      "display": "音量",
      "type": "select",
      "options": {
        "5.0": "5（正常）",
        "0.0": "0（静音）",
        "3.0": "3（较小）",
        "7.0": "7（稍大）",
        "9.0": "9（较大）",
        "11.0": "11（大）",
        "13.0": "13（很大）",
        "15.0": "15（最大）"
      }
    },
    {
      "key": "aue",
      "display": "音频格式",
      "type": "select",
      "options": {
        "3": "mp3（推荐）",
        "6": "wav"
      }
    },
    {
      "key": "timeout",
      "display": "超时时间（秒，留空默认15）",
      "type": "input"
    }
  ],
  "language": {
    "zh_cn": "zh",
    "zh_tw": "zh",
    "en": "zh",
    "ja": "zh",
    "ko": "zh",
    "fr": "zh",
